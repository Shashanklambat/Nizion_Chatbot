# Supabase Dashboard > Connect > URI > Session pooler (5432) or Transaction pooler (6543)
# URL-encode special characters in the database password, e.g. @ becomes %40.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
APP_ENV=development
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-20b

# TEMPORARY TEST SWITCH: false = signup without WhatsApp OTP, true = real OTP required.
# TESTING ONLY: change to true before public launch. Restart the backend after updating.
WHATSAPP_OTP_ENABLED=false

# Meta Cloud API WhatsApp Business sender and an APPROVED authentication copy-code template.
META_WA_ACCESS_TOKEN=your_meta_system_user_token
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_OTP_TEMPLATE=your_approved_authentication_template_name
META_WA_TEMPLATE_LANG=en_US
META_GRAPH_VERSION=v23.0
